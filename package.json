{
  "name": "dsh-voice-chat",
  "version": "0.3.0",
  "description": "豆包式语音对话客户端插件：聊天框麦克风按钮（按住说话）→ 语音转文字发送 → 回复自动朗读。",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maoyuching/dsh-voice-chat.git"
  },
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "MANUAL.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-conversation"
      ],
      "platform": "web",
      "immediately": true
    }
  },
  "dependencies": {
    "ws": "^8.21.3"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "voice",
    "tts",
    "stt",
    "edge-tts",
    "voice-chat"
  ],
  "engines": {
    "node": ">=22"
  },
  "license": "MIT"
}
